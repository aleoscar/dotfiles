/* vim: set filetype=jsonc : */

{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 12,
    "margin-top": 0,
    "modules-left": ["group/power", "custom/updates", "custom/mail", 
        "hyprland/workspaces", "custom/music", "custom/fcitx5", "hyprland/window"],
    "modules-right": ["custom/weather", "network", "bluetooth", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "active-only": true,
        "show-special": true,
        "special-visible-only": true,
    },

    //jag vill ha conditional grejs här som det finns i workspaces
    //om class är tomt vill jag använda title t.ex
    //för spotify, men kanske för annat
    "hyprland/window": {
        "format": "{initialTitle}",
        "rewrite": {
            "(.*)Mozilla Firefox": "Firefox",
            "Spotify(.*)": "Spotify",
            "kitty": "Terminal",
            "(.*)Xournal(.*)": "Xournal++",
            "(.*)Thunar(.*)": "Thunar",
        },
        "max-length": 30,
        "icon": true,
        "icon-size": 16,
        "hide-empty-text": true,
    },

    // "wireplumber": {
    //     "format": "",
    //     "format-muted": " ",
    //     "hide-empty-text": true,
    // },

    "network": {
        "format": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}",
        "on-click": "kitty wlctl"
    },

    "battery": {
        "states": {
            "good": 95,
            "critical": 20
        },
        "format": "{icon}   {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "format": "{:L%a %e %b  %H:%M}",
        "tooltip": true,
        "tooltip-format": "<tt><span size='13500'>{calendar}</span></tt>",
        "calendar": {
                    "mode"          : "month",
                    "weeks-pos"     : "right",
                    "format": {
                              "months":     "<span color='#ffead3'><b>{}</b></span>",
                              "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                              "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                              "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                              "today": "<span background='#ff6699' foreground='#1e1e2e'><b>{}</b></span>"
                              }
                    },
        "locale": "sv_SE.UTF8",
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲", 
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "on-click": "blueman-manager",
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰒳",
            "deactivated": "󰒲"
        }
    },

    "custom/updates": {
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "format": "󰣇  {}",
        "interval": 15,
        "tooltip": false,
        "hide-empty-text": true,
    },

    "custom/mail": {
        "exec": "unread",
        "format": "   {}",
        "interval": 300,    // 5 mins
        "tooltip": false,
        "hide-empty-text": true,
        "on-click": "xdg-open 'https://mail.google.com/mail/'",
    },

    "custom/music": {
        // "exec": "playerctl metadata --ignore-player=firefox --format '{{ title }} - {{ artist }}' --follow",
        "exec": "stdbuf --output=L music-meta",
        "format": "   {}",
        // "interval": once,
        "tooltip": false,
        "hide-empty-text": true,
        "max-length": 40,
        "escape": true,
    },

    "custom/weather": {
        "exec": "weather lund",
        "return-type": "json",
        "format": "{text}",
        "interval": "3600",
        "tooltip": "true",
    },

    "custom/poweroff": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },

    "custom/reboot": {
        "format": "󰑓",
        "tooltip": false,
        "on-click": "systemctl reboot",
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": false,
        "on-click": "hyprlock",
    },

    "custom/fcitx5": {
        "exec": "input-fcitx5",
        "signal": 5
    },

    "group/power": {
        "orientation": "inherit",
        "modules": ["custom/poweroff", "custom/reboot", "custom/lock", "idle_inhibitor"],
        "drawer": {
            "transition-left-to-right": true,
        },
    },
}
