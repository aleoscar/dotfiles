{
    "layer": "top",
    "modules-left": ["custom/updates", "custom/mail", "hyprland/window", "custom/music"],
    "modules-center": ["hyprland/workspaces", "hyprland/mode"],
    "modules-right": ["group/power", "network", "bluetooth", "wireplumber", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "active": "",
            "default": "" 
        },
        "persistent-workspaces": {
            "*": [ 1, 2, 3]
        }
    },

    //jag vill ha conditional grejs här som det finns i workspaces
    //om class är tomt vill jag använda title t.ex
    //för spotify, men kanske för annat
    "hyprland/window": {
        "format": "{initialTitle}",
        "rewrite": {
            "(.*)Mozilla Firefox": "Firefox",
            "Spotify(.*)": "Spotify",
            "kitty": "Terminal"
        },
        "max-length": 50,
        "icon": true,
        "icon-size": 16,
    },

    "wireplumber": {
        "format": "",
        "format-muted": " "
    },

    "network": {
        "format": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}",
        "on-click": "iwgtk",
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}    {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "format-alt": "{:L%a %d %b  %H:%M}",
        "tooltip": false,
        "locale": "sv_SE.UTF8"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲", 
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "on-click": "blueman-manager",
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰒳",
            "deactivated": "󰒲"
        }
    },

    "custom/updates": {
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "format": "󰣇  {}",
        "interval": 15,
        "tooltip": false,
        "hide-empty-text": true,
    },

    "custom/mail": {
        "exec": "unread",
        "format": "󰊫   {}",
        "interval": 900,    // 15 mins
        "tooltip": false,
        "hide-empty-text": true,
        "on-click": "xdg-open 'https://mail.google.com/mail/'",
    },

    "custom/music": {
        "exec": "playerctl metadata --ignore-player=firefox --format '{{ title }} - {{ artist }}'",
        // skulle vilja lösa det på något sätt så man slipper polla och det körs bara när sången byts
        // Av någon anledning funkar det inte heller om texten innehåller "&"
        "format": "   {}",
        "interval": 2,
        "tooltip": false,
        "hide-empty-text": true,
    },

    "custom/poweroff": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },

    "custom/reboot": {
        "format": "󰑓",
        "tooltip": false,
        "on-click": "systemctl reboot",
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": false,
        "on-click": "hyprlock",
    },

    "group/power": {
        "orientation": "inherit",
        "modules": ["custom/poweroff", "idle_inhibitor", "custom/lock", "custom/reboot"],
        "drawer": {
            "transition-left-to-right": false,
        },
    },
}
