/* vim: set filetype=jsonc : */

{
    "layer": "top",
    "height": 30,
    "spacing": 12,
    "margin-top": 6,
    "modules-left": ["group/power", "custom/updates", "custom/mail", "hyprland/window", "custom/music"],
    "modules-center": ["hyprland/workspaces", "hyprland/mode"],
    "modules-right": ["network", "bluetooth", "wireplumber", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "active": "",
            "default": "" 
        },
        "persistent-workspaces": {
            "*": [ 1, 2, 3]
        },
    },

    //jag vill ha conditional grejs här som det finns i workspaces
    //om class är tomt vill jag använda title t.ex
    //för spotify, men kanske för annat
    "hyprland/window": {
        "format": "{initialTitle}",
        "rewrite": {
            "(.*)Mozilla Firefox": "Firefox",
            "Spotify(.*)": "Spotify",
            "kitty": "Terminal",
            "(.*)Xournal(.*)": "Xournal++",
            "(.*)Thunar(.*)": "Thunar",
        },
        "max-length": 30,
        "icon": true,
        "icon-size": 16,
        "hide-empty-text": true,
    },

    // "wireplumber": {
    //     "format": "",
    //     "format-muted": " ",
    //     "hide-empty-text": true,
    // },

    "network": {
        "format": "󰖩",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}",
        "on-click": "kitty nmtui"
    },

    "battery": {
        "states": {
            "good": 95,
            "critical": 20
        },
        "format": "{icon}    {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        "format": "{:L%a %e %b  %H:%M}",
        "tooltip": false,
        "locale": "sv_SE.UTF8",
        "on-click": "kitty calcurse"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲", 
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "on-click": "blueman-manager",
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰒳",
            "deactivated": "󰒲"
        }
    },

    "custom/updates": {
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "format": "󰣇  {}",
        "interval": 15,
        "tooltip": false,
        "hide-empty-text": true,
    },

    "custom/mail": {
        "exec": "unread",
        "format": "󰊫   {}",
        "interval": 300,    // 5 mins
        "tooltip": false,
        "hide-empty-text": true,
        "on-click": "xdg-open 'https://mail.google.com/mail/'",
    },

    "custom/music": {
        // "exec": "playerctl metadata --ignore-player=firefox --format '{{ title }} - {{ artist }}' --follow",
        "exec": "stdbuf --output=L music-meta",
        "format": "   {}",
        // "interval": once,
        "tooltip": false,
        "hide-empty-text": true,
        "max-length": 40,
        "escape": true,
    },

    "custom/poweroff": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "systemctl poweroff"
    },

    "custom/reboot": {
        "format": "󰑓",
        "tooltip": false,
        "on-click": "systemctl reboot",
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": false,
        "on-click": "hyprlock",
    },

    "group/power": {
        "orientation": "inherit",
        "modules": ["custom/poweroff", "custom/reboot", "custom/lock", "idle_inhibitor"],
        "drawer": {
            "transition-left-to-right": true,
        },
    },
}
