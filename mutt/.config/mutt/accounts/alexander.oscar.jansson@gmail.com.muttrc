# vim: filetype=neomuttrc
# muttrc file for account alexander.oscar.jansson@gmail.com
set realname = "Alexander Jansson"
set from = "alexander.oscar.jansson@gmail.com"
set sendmail = "msmtp -a alexander.oscar.jansson@gmail.com"
alias me alexander.oscar.jansson <alexander.oscar.jansson@gmail.com>
set folder = "/home/sanej/.local/share/mail/alexander.oscar.jansson@gmail.com"
set header_cache = /home/sanej/.cache/mutt-wizard/alexander.oscar.jansson@gmail.com/headers
set message_cachedir = /home/sanej/.cache/mutt-wizard/alexander.oscar.jansson@gmail.com/bodies
set mbox_type = Maildir
set hostname = "gmail.com"
source /usr/share/mutt-wizard/switch.muttrc
set spoolfile = +INBOX
set postponed = +Drafts
set trash = +Trash
set record = +Sent

macro index o "<shell-escape>mw -y alexander.oscar.jansson@gmail.com<enter>" "run mbsync to sync alexander.oscar.jansson@gmail.com"
macro index \eg "<enter-command>unset wait_key<enter><shell-escape>gpg --list-secret-keys; printf 'Enter email ID of user to publish: '; read eID; printf 'Enter fingerprint of GPG key to publish: '; read eFGPT; /usr/libexec/gpg-wks-client --create \$eFGPT \$eID | msmtp --read-envelope-from --read-recipients -a alexander.oscar.jansson@gmail.com<enter>"  "publish GPG key to WKS provider"
macro index \eh "<pipe-message>/usr/libexec/gpg-wks-client --receive | msmtp --read-envelope-from --read-recipients -a alexander.oscar.jansson@gmail.com<enter>" "confirm GPG publication"

mailboxes "=INBOX" "=[Gmail]/Papperskorgen" "=[Gmail]/Skickat" "=[Gmail]/Utkast" "=[Gmail]/Viktigt" 
named-mailboxes All "=[Gmail]/All e-post"
