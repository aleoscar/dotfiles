# colors
include ~/.config/newsboat/dark

datetime-format "%b %d %Y"

# max articles to cache
max-items 1000

browser firefox

# key bindings
bind j everywhere down
bind k everywhere up
bind u everywhere pageup
bind d everywhere pagedown
bind U article show-urls

# podboat
bind d podboat pb-download
download-path "~/Music/podcasts"
player "mpv"
delete-played-files yes
